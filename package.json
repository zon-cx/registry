{
  "name": "remix",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "build": "remix vite:build",
    "dev": "bash scripts/dev.sh",
    "dev:remix": "remix vite:dev",
    "postinstall": "node_modules/.bin/deno cache --allow-import deno/main.tsx || true",
    "lint": "eslint --ignore-path .gitignore --cache --cache-location ./node_modules/.cache/eslint .",
    "start": "netlify serve",
    "typecheck": "tsc",
    "deno:zon-gallery": "deno serve --env-file -A d",
    "deno:http": "deno serve --env-file -A deno/handlers.tsx",
    "deno:editor": "deno serve --env-file -A deno/editor.tsx"
  },
  "dependencies": {
    "@cxai/ide": "^1.0.19",
    "@netlify/functions": "^2.6.0",
    "@netlify/remix-adapter": "^2.3.1",
    "@remix-run/node": "^2.16.5",
    "@remix-run/react": "^2.16.5",
    "@remix-run/serve": "^2.16.5",
    "@valtown/sdk": "^1.0.0",
    "isbot": "^4.1.0",
    "lucide-react": "^0.503.0",
    "tailwindcss": "^4.1.4"
  },
  "devDependencies": {
    "@remix-run/dev": "^2.16.5",
    "@tailwindcss/vite": "^4.1.4",
    "@types/react": "^18.2.20",
    "@types/react-dom": "^18.2.7",
    "@typescript-eslint/eslint-plugin": "^6.7.4",
    "deno": "^2.9.2",
    "eslint": "^8.38.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-import-resolver-typescript": "^3.6.1",
    "eslint-plugin-import": "^2.28.1",
    "eslint-plugin-jsx-a11y": "^6.7.1",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "typescript": "^5.1.6",
    "vite": "^5.4.8",
    "vite-tsconfig-paths": "^4.2.1"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
