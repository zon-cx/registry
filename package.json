    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-router": "7.18.1",
    "ws": "8.21.0",
    "yjs": "13.6.31"
  },
  "devDependencies": {
    "@react-router/dev": "7.18.1",
    "@tailwindcss/vite": "4.1.4",
