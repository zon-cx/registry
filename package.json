{
  "name": "registry",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "build": "node_modules/.bin/deno cache --allow-import deno/main.tsx || true",
    "dev": "URL_ZONS=/ URL_ZON=/zon URL_FILES=/file node --env-file-if-exists=.env.development.local --import tsx --import ./scripts/node-register.mjs deno/node.ts",
    "dev:deno": "URL_ZONS=/ URL_ZON=/zon URL_FILES=/file deno serve -A --port ${DEV_PORT:-5173} --env-file=.env.development.local deno/main.tsx",
    "postinstall": "node_modules/.bin/deno cache --allow-import deno/main.tsx || true",
    "lint": "eslint --ignore-path .gitignore --cache --cache-location ./node_modules/.cache/eslint .",
    "typecheck": "tsc"
  },
  "dependencies": {
    "@cxai/ide": "^1.0.19",
    "@hocuspocus/provider": "^2.15.3",
    "@hono/node-server": "^1.19.14",
    "@valtown/sdk": "^1.0.0",
    "hono": "^4.12.28"
  },
  "devDependencies": {
    "@types/react": "^18.2.20",
    "@types/react-dom": "^18.2.7",
    "@typescript-eslint/eslint-plugin": "^6.7.4",
    "deno": "^2.9.2",
    "eslint": "^8.38.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-import-resolver-typescript": "^3.6.1",
    "eslint-plugin-import": "^2.28.1",
    "eslint-plugin-jsx-a11y": "^6.7.1",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "tsx": "^4.23.0",
    "typescript": "^5.1.6"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
